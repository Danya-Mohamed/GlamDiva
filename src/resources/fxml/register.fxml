<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:controller="controllers.RegisterController" xmlns:fx="http://javafx.com/fxml" prefWidth="400" prefHeight="300">
    <VBox alignment="CENTER" spacing="15" layoutX="50" layoutY="50">
        <Label text="Register New User" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <TextField fx:id="usernameField" promptText="Username" />
        <PasswordField fx:id="passwordField" promptText="Password" />
        <HBox spacing="10">
            <Button text="Register" onAction="#register" />
            <Button text="Back to Login" onAction="#goToLogin" />
        </HBox>
    </VBox>
</AnchorPane>