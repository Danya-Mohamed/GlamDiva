<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:controller="controllers.AddItemController" xmlns:fx="http://javafx.com/fxml" prefWidth="400" prefHeight="400">
    <VBox spacing="10" alignment="CENTER" layoutX="50" layoutY="30">
        <Label text="Add New Fashion Item" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <TextField fx:id="nameField" promptText="Item Name" />
        <TextField fx:id="categoryField" promptText="Category" />
        <TextField fx:id="priceField" promptText="Price" />
        <TextField fx:id="imagePathField" promptText="Image Path (optional)" />
        <Button text="Add Item" onAction="#addItem" />
    </VBox>
</AnchorPane>