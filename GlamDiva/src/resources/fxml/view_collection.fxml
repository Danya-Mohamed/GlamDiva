<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:controller="controllers.ViewCollectionController" xmlns:fx="http://javafx.com/fxml" prefWidth="600" prefHeight="400">
