        <Label text="Your Fashion Collection" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
        <TextArea fx:id="itemDisplay" prefHeight="300" prefWidth="550" editable="false" />
    </VBox>
</AnchorPane>