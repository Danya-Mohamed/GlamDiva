<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:controller="controllers.DashboardController" xmlns:fx="http://javafx.com/fxml" prefWidth="600" prefHeight="400">
    <VBox alignment="CENTER" spacing="20" layoutX="100" layoutY="50">
        <Label fx:id="welcomeLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
        <Button text="Add Fashion Item" onAction="#goToAddItem" />
        <Button text="View Collection" onAction="#goToViewCollection" />
        <Button text="Settings" onAction="#goToSettings" />
    </VBox>
</AnchorPane>